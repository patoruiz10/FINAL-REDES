options {
    directory "/var/cache/bind";

    # Resolver dominios que no son de la empresa
    recursion yes;

    allow-query { any; };
    allow-recursion { any; };

    #Consultas externas se reenvian a los DNS de google
    forwarders {
        8.8.8.8;
        8.8.4.4;
    };

    dnssec-validation no;
    listen-on { any; };
    listen-on-v6 { none; };
};
