// ===== Zona directa =====
zone "selvent.izo" {
    type master;
    file "/etc/bind/db.selvent.izo";
};

// ===== Zonas inversas =====
// 10.x.x.x       -> LAN A (10.0.0.0/15) y LAN T (10.2.0.0/15)
zone "10.in-addr.arpa" {
    type master;
    file "/etc/bind/db.10";
};

// 172.16.x.x     -> LAN B, K, L, N, R
zone "16.172.in-addr.arpa" {
    type master;
    file "/etc/bind/db.172.16";
};

// 172.20.x.x     -> LAN C, S
zone "20.172.in-addr.arpa" {
    type master;
    file "/etc/bind/db.172.20";
};

// 172.18.x.x     -> LAN V, Q
zone "18.172.in-addr.arpa" {
    type master;
    file "/etc/bind/db.172.18";
};

// 172.19.x.x     -> LAN E, H, P
zone "19.172.in-addr.arpa" {
    type master;
    file "/etc/bind/db.172.19";
};

// 192.168.x.x    -> enlaces entre routers y LAN D, F, G, I, J, M, O, X
zone "168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/db.192.168";
};
