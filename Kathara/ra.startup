
ulimit -n 1024
/etc/init.d/quagga start 

ip address add 10.1.255.254/15 dev eth0
ip address add 192.168.0.1/30 dev eth1
ip address add 192.168.0.78/30 dev eth2


# NAT hacia Internet
iptables -t nat -A POSTROUTING -o eth3 -j MASQUERADE

/etc/init.d/isc-dhcp-server start

# Publica el servidor HTTP de hb hacia Internet (puerto 80)
iptables -t nat -A PREROUTING -i eth3 -p tcp --dport 80 -j DNAT --to-destination 172.16.0.1:80

